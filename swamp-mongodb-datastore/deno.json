{
  "fmt": {
    "include": ["**/*.ts", "**/*.md", "**/*.json", "**/*.jsonc"],
    "exclude": [".swamp/", "node_modules/"]
  },
  "lint": {
    "include": ["extensions/"],
    "exclude": [".swamp/"],
    "rules": {
      "exclude": ["no-import-prefix"]
    }
  },
  "tasks": {
    "check": "deno check extensions/datastores/mongodb/mod.ts",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "test": "deno test --allow-read --allow-write --allow-env",
    "test:soak": "FC_NUM_RUNS=10000 deno test --allow-read --allow-write --allow-env=FC_NUM_RUNS extensions/models/sync_property_test.ts"
  }
}
