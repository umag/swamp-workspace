{
  "tasks": {
    "check": "deno check extensions/",
    "test": "deno test --allow-env=FC_NUM_RUNS --allow-read=fixtures --permit-no-files extensions/",
    "test:soak": "FC_NUM_RUNS=10000 deno test --allow-env=FC_NUM_RUNS --allow-read=fixtures extensions/models/tmdb_property_test.ts",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint"
  },
  "imports": {
    "zod": "npm:zod@4"
  },
  "compilerOptions": {
    "noImplicitAny": false
  },
  "fmt": {
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "exclude": [
      "fixtures"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  }
}
