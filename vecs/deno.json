{
  "tasks": {
    "check": "deno check extensions/models/vecs.ts extensions/models/vecs_test.ts scripts/build_reference.ts scripts/build_reference_test.ts",
    "test": "deno test --allow-read .",
    "build-reference": "deno run --allow-net --allow-read --allow-write scripts/build_reference.ts",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint"
  },
  "imports": {
    "zod": "npm:zod@4"
  },
  "compilerOptions": {
    "noImplicitAny": false
  },
  "fmt": {
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
