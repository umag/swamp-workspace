    "test:live": "LIVE_PIHOLE=1 deno test --allow-env=FC_NUM_RUNS,LIVE_PIHOLE,PIHOLE_LIVE_HOST,PIHOLE_LIVE_PASSWORD --allow-read=extensions,fixtures --allow-net extensions/models/pihole_live_test.ts",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint"
  },
  "imports": {
    "zod": "npm:zod@4"
