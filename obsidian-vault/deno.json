{
  "tasks": {
    "check": "deno check extensions/models/",
    "test": "deno test extensions/models/ --permit-no-files --allow-read --allow-write --allow-env",
    "test:soak": "FC_NUM_RUNS=10000 deno test --allow-read --allow-write --allow-env extensions/models/obsidian_vault_property_test.ts",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint"
  },
  "imports": { "zod": "npm:zod@4" },
  "compilerOptions": { "noImplicitAny": false },
  "fmt": {
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "exclude": ["extensions/models/fixtures/"]
  },
  "lint": { "rules": { "tags": ["recommended"] } }
}
