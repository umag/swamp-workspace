{
  "tasks": {
    "build-promptfoo": "deno run --allow-read --allow-write build-promptfoo-tests.ts",
    "check": "deno check build-promptfoo-tests.ts build-ci-report.ts quality/*.ts lib/watch_schema.ts lib/soak_permissions.ts release_watch.ts soak_schedule.ts run_soak.ts registry_drift.ts release_notes_gate.ts attestation.ts",
    "registry-drift": "deno run --allow-read --allow-run=swamp registry_drift.ts --root ..",
    "release-notes-gate": "deno run --allow-read --allow-run=git,bash --allow-env=EVENT,PR_BASE_SHA,PUSH_BEFORE release_notes_gate.ts",
    "attestation": "deno run --allow-read --allow-write --allow-env=GITHUB_OUTPUT attestation.ts",
    "test": "deno test --allow-read --allow-write --allow-run --allow-env=FC_NUM_RUNS,QUALITY_REPO_ROOT,PATH .",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "quality:check": "deno run --allow-read --allow-write --allow-env=QUALITY_REPO_ROOT quality/check_compliance.ts",
    "quality:allowlist": "deno run --allow-read --allow-write --allow-run=git --allow-env=QUALITY_REPO_ROOT quality/check_allowlist.ts",
    "quality:ratchet": "deno run --allow-read --allow-write --allow-run=swamp --allow-env=QUALITY_REPO_ROOT quality/score_ratchet.ts",
    "quality:harness": "deno run --allow-read --allow-write --allow-env=QUALITY_REPO_ROOT quality/check_property_harness.ts",
    "quality:soak": "deno run --allow-read --allow-write --allow-env=QUALITY_REPO_ROOT quality/check_soak.ts",
    "quality:soak-parity": "deno run --allow-read --allow-write --allow-env=QUALITY_REPO_ROOT quality/check_soak_parity.ts",
    "quality:upgrades": "deno run --allow-read --allow-write=../upgrade-chain-summary.json --allow-env=QUALITY_REPO_ROOT quality/check_upgrade_chain.ts",
    "quality:generate-soak": "deno run --allow-read --allow-write --allow-env=QUALITY_REPO_ROOT quality/generate_soak_task.ts",
    "quality:scaffold": "deno run --allow-read --allow-write quality/scaffold.ts"
  },
  "imports": { "zod": "npm:zod@4" },
  "fmt": {
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
