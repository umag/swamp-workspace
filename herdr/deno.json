{
  "tasks": {
    "check": "deno check extensions/models/",
    "test": "deno test --allow-read=fixtures --allow-env=FC_NUM_RUNS --allow-run=sh extensions/models/",
    "test:soak": "FC_NUM_RUNS=2000 deno test --allow-read=fixtures --allow-env=FC_NUM_RUNS --allow-run=sh extensions/models/herdr_property_test.ts",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint"
  },
  "imports": {
    "zod": "npm:zod@4"
  },
  "compilerOptions": {
    "noImplicitAny": false
  },
  "fmt": {
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
